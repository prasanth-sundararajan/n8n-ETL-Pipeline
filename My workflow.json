    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst seen = new Set();\nconst results = [];\n\nfor (const item of items) {\n  let data = item.json;\n\n  // 1. Normalize unique identifiers for reliable duplicate checking\n  let studentId = (data.Student_ID || \"\").trim();\n  let email = (data.Email || \"\").trim().toLowerCase();\n  let uniqueKey = studentId || email;\n\n  let isDuplicate = false;\n  if (uniqueKey && seen.has(uniqueKey)) {\n    isDuplicate = true;\n  } else if (uniqueKey) {\n    seen.add(uniqueKey);\n  }\n\n  // 2. Name: Title Case\n  let name = (data.Name || \"\").trim();\n  name = name.toLowerCase().replace(/\\b\\w/g, c => c.toUpperCase());\n\n  // 3. Email validation\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n  let validEmail = email;\n  if (!emailRegex.test(validEmail)) {\n    validEmail = \"INVALID_EMAIL\";\n  }\n\n  // 4. Phone validation\n  let rawPhone = data.Phone || \"\";\n  let phone = String(rawPhone).replace(/\\D/g, '');\n  if (phone.length < 10) {\n    phone = \"MISSING\";\n  }\n\n  // 5. Course standardization\n  let course = (data.Course || \"\").trim();\n  const validCourses = [\"Python\", \"Machine Learning\", \"Data Science\"];\n  const matchedCourse = validCourses.find(c => c.toLowerCase() === course.toLowerCase());\n  course = matchedCourse || \"Python\";\n\n  // 6. Fee_Paid conversion\n  let feePaid = data.Fee_Paid;\n  if (typeof feePaid === 'string') {\n    const lower = feePaid.toLowerCase();\n    if (lower === 'yes' || lower === 'true') feePaid = true;\n    else if (lower === 'no' || lower === 'false') feePaid = false;\n  }\n  feePaid = Boolean(feePaid);\n\n  // 7. City formatting\n  let city = (data.City || \"\").trim();\n  if (!city) {\n    city = \"UNKNOWN\";\n  } else {\n    city = city.toLowerCase().replace(/\\b\\w/g, c => c.toUpperCase());\n  }\n\n  // 8. Date formatting\n  let enrolledDate = (data.Enrolled_Date || \"\").trim();\n  const parsedDate = new Date(enrolledDate);\n  if (!isNaN(parsedDate.getTime())) {\n    enrolledDate = parsedDate.toISOString().split('T')[0];\n  } else {\n    enrolledDate = \"2025-01-01\";\n  }\n\n  // Determine category for Switch node routing\n  let category = \"unpaid\";\n  if (isDuplicate) {\n    category = \"duplicate\";\n  } else if (feePaid === true) {\n    category = \"paid\";\n  }\n\n  results.push({\n    json: {\n      Student_ID: studentId,\n      Name: name,\n      Email: validEmail,\n      Phone: phone,\n      Course: course,\n      Fee_Paid: feePaid,\n      City: city,\n      Enrolled_Date: enrolledDate,\n      category: category\n    }\n  });\n}\n\nreturn results;"
      },
